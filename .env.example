# Africonnect Invoicing: copy this file to .env.local and fill in the key.
# Restart `npm run dev` after changing it. NEXT_PUBLIC_ values are built into
# the browser bundle, so they must never hold a secret.

# Copy both values (do not retype them) from Supabase dashboard → Connect
# (top bar) → App Frameworks → Next.js,
# or Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
# The *publishable* key (starts with sb_publishable_). The legacy "anon"
# key also works. Never use the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "supabase": shared database (set this in production, so a missing key
#             shows an error instead of quietly falling back).
# "local":    browser-only demo with fictional data; used by the e2e suite.
# Unset:      Supabase when both values above are present, otherwise local.
NEXT_PUBLIC_DATA_BACKEND=supabase
